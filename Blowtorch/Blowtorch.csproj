<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	<UseWindowsForms>true</UseWindowsForms>
	  <ApplicationIcon>blowtorch.ico</ApplicationIcon>
    <UserSecretsId>4d598b32-80af-492e-bb4d-59bade391cb1</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fuse\Fuse.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="JoltPhysicsSharp" Version="2.21.0" />
    <PackageReference Include="Silk.NET.Assimp" Version="2.22.0" />
    <PackageReference Include="Silk.NET.GLFW" Version="2.22.0" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.22.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
    <PackageReference Include="StbTrueTypeSharp" Version="1.26.13" />
	<FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <!--
    A ProjectReference copies Fuse.dll, but the Fuse apphost is not guaranteed
    to be copied to the Blowtorch output directory. The editor launches the
    game from that directory when F5/Play is used, so keep the complete Fuse
    runtime beside Blowtorch.exe.
  -->
  <Target Name="CopyFuseRuntimeToBlowtorch" AfterTargets="Build">
    <ItemGroup>
      <FuseRuntimeFile Include="$(MSBuildProjectDirectory)\..\Fuse\bin\$(Configuration)\$(TargetFramework)\Fuse.exe" />
      <FuseRuntimeFile Include="$(MSBuildProjectDirectory)\..\Fuse\bin\$(Configuration)\$(TargetFramework)\Fuse.dll" />
      <FuseRuntimeFile Include="$(MSBuildProjectDirectory)\..\Fuse\bin\$(Configuration)\$(TargetFramework)\Fuse.deps.json" />
      <FuseRuntimeFile Include="$(MSBuildProjectDirectory)\..\Fuse\bin\$(Configuration)\$(TargetFramework)\Fuse.runtimeconfig.json" />
      <FuseRuntimeFile Include="$(MSBuildProjectDirectory)\..\Fuse\bin\$(Configuration)\$(TargetFramework)\Fuse.pdb" Condition="Exists('$(MSBuildProjectDirectory)\..\Fuse\bin\$(Configuration)\$(TargetFramework)\Fuse.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(FuseRuntimeFile)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="false"
          Condition="Exists('%(FuseRuntimeFile.Identity)')" />
  </Target>

</Project>
