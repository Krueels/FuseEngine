#version 430 core

const int TILE_SIZE = 16;
const int MAX_POINT_LIGHTS = 128;
const int MAX_SPOT_LIGHTS = 128;
const int MAX_LIGHTS_PER_TILE = 64;

struct PointLightData {
    vec4 positionRadius;
    vec4 colorShadowIndex;
    vec4 params;
};

struct SpotLightData {
    vec4 positionRadius;
    vec4 directionInnerCos;
    vec4 colorOuterCos;
    vec4 shadowParams;
};

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 2) buffer ForwardPlusTileListBuffer {
    uvec4 uTileLists[];
};

layout(std430, binding = 3) buffer ForwardPlusLightIndexBuffer {
    uint uLightIndices[];
};

layout(std430, binding = 4) readonly buffer ForwardPlusLightBuffer {
    PointLightData uPointLights[MAX_POINT_LIGHTS];
    SpotLightData uSpotLights[MAX_SPOT_LIGHTS];
};

uniform mat4 uView;
uniform mat4 uProj;
uniform vec2 uScreenSize;
uniform int uTileCountX;
uniform int uTileCountY;
uniform int uPointLightCount;
uniform int uSpotLightCount;

bool SphereIntersectsTile(vec3 worldPosition, float radius, uvec2 tile)
{
    vec3 viewPosition = (uView * vec4(worldPosition, 1.0)).xyz;
    float viewDepth = -viewPosition.z;

    // A sphere crossing the camera plane can touch any visible tile.
    if (viewDepth <= radius)
        return viewDepth + radius >= 0.0;
    if (viewDepth + radius < 0.0)
        return false;

    vec4 clipPosition = uProj * vec4(viewPosition, 1.0);
    if (clipPosition.w <= 0.0)
        return false;

    vec2 centerNdc = clipPosition.xy / clipPosition.w;
    vec2 radiusNdc = vec2(
        abs(uProj[0][0]) * radius / viewDepth,
        abs(uProj[1][1]) * radius / viewDepth);

    vec2 tileMin = vec2(tile * uint(TILE_SIZE)) / uScreenSize * 2.0 - 1.0;
    vec2 tileMax = vec2((tile + uvec2(1)) * uint(TILE_SIZE)) / uScreenSize * 2.0 - 1.0;
    vec2 closestPoint = clamp(centerNdc, tileMin, tileMax);
    vec2 normalizedDistance = (centerNdc - closestPoint) / max(radiusNdc, vec2(0.00001));
    return dot(normalizedDistance, normalizedDistance) <= 1.0;
}

void main()
{
    uvec2 tile = gl_GlobalInvocationID.xy;
    if (tile.x >= uint(uTileCountX) || tile.y >= uint(uTileCountY))
        return;

    uint tileIndex = tile.y * uint(uTileCountX) + tile.x;
    uint tileBase = tileIndex * uint(MAX_LIGHTS_PER_TILE * 2);
    uvec4 counts = uvec4(0);

    for (int i = 0; i < uPointLightCount; i++)
    {
        PointLightData light = uPointLights[i];
        if (SphereIntersectsTile(light.positionRadius.xyz, light.positionRadius.w, tile) &&
            counts.x < uint(MAX_LIGHTS_PER_TILE))
        {
            uLightIndices[tileBase + counts.x] = uint(i);
            counts.x++;
        }
    }

    for (int i = 0; i < uSpotLightCount; i++)
    {
        SpotLightData light = uSpotLights[i];
        if (SphereIntersectsTile(light.positionRadius.xyz, light.positionRadius.w, tile) &&
            counts.y < uint(MAX_LIGHTS_PER_TILE))
        {
            uLightIndices[tileBase + uint(MAX_LIGHTS_PER_TILE) + counts.y] = uint(i);
            counts.y++;
        }
    }

    uTileLists[tileIndex] = counts;
}
