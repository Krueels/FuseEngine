#version 430 core

// Procedural spectral-style ocean cascade. Each dispatch creates one tile of
// smooth, tileable displacement data. The three tiles are sampled at different
// world scales by ocean.vert, which gives the surface the same multi-band
// structure used by spectral ocean systems without coupling the underwater
// pass to a second wave evaluator.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(rgba16f, binding = 0) uniform writeonly image2D uOutput;

uniform int uSize;
uniform int uBand;
uniform float uTime;
uniform float uAmplitude;
uniform float uWaveSpeed;
uniform float uWaveChoppiness;
uniform vec2 uWaveDirection;

const float PI = 3.14159265359;
const float TWO_PI = 6.28318530718;

vec2 BandDirection(int index)
{
    const vec2 directions[4] = vec2[](
        vec2(1.00, 0.06),
        vec2(-0.74, 0.67),
        vec2(0.38, -0.93),
        vec2(0.86, -0.51));
    return directions[index];
}

vec2 BandFrequency(int band, int index)
{
    if (band == 0)
    {
        const vec2 values[4] = vec2[](
            vec2(1.0, 0.0), vec2(1.0, 1.0), vec2(2.0, -1.0), vec2(1.0, 2.0));
        return values[index];
    }
    if (band == 1)
    {
        const vec2 values[4] = vec2[](
            vec2(1.0, 0.0), vec2(2.0, 1.0), vec2(3.0, -2.0), vec2(4.0, 1.0));
        return values[index];
    }
    const vec2 values[4] = vec2[](
        vec2(1.0, 1.0), vec2(2.0, -1.0), vec2(3.0, 2.0), vec2(5.0, -3.0));
    return values[index];
}

float ComponentWeight(int index)
{
    const float values[4] = float[](0.58, 0.25, 0.12, 0.05);
    return values[index];
}

float BandAmplitude(int band)
{
    if (band == 0)
        return 0.72;
    if (band == 1)
        return 0.24;
    return 0.10;
}

float BandSpeed(int band)
{
    if (band == 0)
        return 0.42;
    if (band == 1)
        return 0.78;
    return 1.26;
}

float PhaseOffset(int band, int index)
{
    if (band == 0)
    {
        const float offsets[4] = float[](0.17, 2.41, 4.88, 1.33);
        return offsets[index];
    }
    if (band == 1)
    {
        const float offsets[4] = float[](1.79, 4.20, 0.62, 3.51);
        return offsets[index];
    }
    const float offsets[4] = float[](3.14, 0.91, 5.37, 2.28);
    return offsets[index];
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= uSize || pixel.y >= uSize)
        return;

    vec2 coordinate = (vec2(pixel) + 0.5) / float(uSize);
    vec2 forward = length(uWaveDirection) > 0.001
        ? normalize(uWaveDirection)
        : vec2(1.0, 0.0);
    vec2 side = vec2(-forward.y, forward.x);

    vec2 horizontalDisplacement = vec2(0.0);
    float height = 0.0;
    float bandAmplitude = max(uAmplitude, 0.0) * BandAmplitude(uBand);

    for (int i = 0; i < 4; ++i)
    {
        vec2 direction = normalize(
            forward * BandDirection(i).x + side * BandDirection(i).y);
        // Integer frequency vectors make the generated tile seamless in both
        // axes. The user direction still controls the horizontal crest
        // displacement, while the periodic phase prevents visible texture
        // seams when the tile repeats across the ocean.
        vec2 frequency = BandFrequency(uBand, i);
        float phase = TWO_PI * dot(coordinate, frequency) -
            uTime * uWaveSpeed * BandSpeed(uBand) +
            PhaseOffset(uBand, i);
        float sine = sin(phase);
        float cosine = cos(phase);
        float componentAmplitude = bandAmplitude * ComponentWeight(i);

        height += componentAmplitude * sine;
        horizontalDisplacement += direction *
            (componentAmplitude * uWaveChoppiness * (0.82 + 0.12 * float(i)) * cosine);

        // A restrained second harmonic sharpens only the crests. This keeps
        // the surface organic without producing the triangular spikes of a
        // single steep Gerstner wave.
        height += componentAmplitude * 0.075 * sin(phase * 2.0 + 0.31);
    }

    imageStore(uOutput, pixel, vec4(
        horizontalDisplacement.x,
        height,
        horizontalDisplacement.y,
        1.0));
}
